#include <LiquidCrystal.h>
#include <avr/io.h>
#include <avr/interrupt.h>

LiquidCrystal lcd(12, 11, 5, 4, 3, 2);

volatile uint8_t ore = 12;
volatile uint8_t minute = 0;
volatile uint8_t secunde = 55;
volatile bool actualizare_ecran = true;

void adc_init() {
  ADMUX = (1 << REFS0);
  ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);
}

uint16_t adc_read(uint8_t canal) {
  ADMUX = (ADMUX & 0xF0) | (canal & 0x07);
  ADCSRA |= (1 << ADSC);
  while (ADCSRA & (1 << ADSC));
  return ADC;
}

void timer1_init() {
  cli();

  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1  = 0;

  OCR1A = 62499;

  TCCR1B |= (1 << WGM12);
  TCCR1B |= (1 << CS12);
  TIMSK1 |= (1 << OCIE1A);

  sei();
}

ISR(TIMER1_COMPA_vect) {
  secunde++;
  if (secunde >= 60) {
    secunde = 0;
    minute++;
    if (minute >= 60) {
      minute = 0;
      ore++;
      if (ore >= 24) {
        ore = 0;
      }
    }
  }
  actualizare_ecran = true;
}

void setup() {
  Serial.begin(9600);
  lcd.begin(16, 2);

  adc_init();
  timer1_init();
}

void loop() {
  if (actualizare_ecran) {
    actualizare_ecran = false;

    uint16_t raw_adc = adc_read(0);
    float tensiune_mv = (raw_adc * 5000.0) / 1024.0;
    float temperatura = (tensiune_mv - 500.0) / 10.0;

    char buffer_ora[17];
    snprintf(buffer_ora, sizeof(buffer_ora), "Ora %02d:%02d:%02d", ore, minute, secunde);

    char buffer_temp[17];
    snprintf(buffer_temp, sizeof(buffer_temp), "Temp = %d\xDF\x43", (int)round(temperatura));

    lcd.setCursor(0, 0);
    lcd.print(buffer_temp);
    lcd.print("     ");
    
    lcd.setCursor(0, 1);
    lcd.print(buffer_ora);

    Serial.print(buffer_temp);
    Serial.print(" | ");
    Serial.println(buffer_ora);
  }
}
